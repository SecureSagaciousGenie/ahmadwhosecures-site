---
// Author: Ahmad Shaukat
// The site insignia, drawn as an embroidered patch. "Semper proba": always verify.
// Four stars for the four checks every sign-in passes (who, device, place, risk);
// the shield carries the evidence mark. A personal emblem, not modelled on any official seal.
interface Props {
  size?: number;
  class?: string;
  label?: string;
}

const { size = 220, class: cls, label } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const C = 120;
const rad = (deg: number) => (deg * Math.PI) / 180;
const at = (r: number, deg: number) => [C + r * Math.cos(rad(deg)), C + r * Math.sin(rad(deg))];
const f = (n: number) => n.toFixed(2);

// Bezel ticks every 10 degrees, longer at the four quarters.
const ticks = Array.from({ length: 36 }, (_, i) => {
  const deg = i * 10;
  const long = deg % 90 === 0;
  const [x1, y1] = at(79.5, deg);
  const [x2, y2] = at(long ? 73 : 76, deg);
  return { x1, y1, x2, y2, long };
});

// Laurel leaves along two arcs that meet under the shield. Angles in screen space: 90 is down.
const leaves: { x: number; y: number; rot: number; tone: 'a' | 'b' }[] = [];
const branch = (from: number, to: number, side: 1 | -1) => {
  const steps = 8;
  for (let i = 0; i <= steps; i++) {
    const deg = from + ((to - from) * i) / steps;
    for (const offset of [-4.2, 4.2]) {
      const [x, y] = at(66 + offset, deg);
      const tangent = deg + 90 * side;
      leaves.push({ x, y, rot: tangent + (offset > 0 ? 28 : -28) * side, tone: i % 2 ? 'a' : 'b' });
    }
  }
};
branch(104, 198, 1);
branch(76, -18, -1);
const arc = (from: number, to: number, sweep: 0 | 1) => {
  const [x1, y1] = at(66, from);
  const [x2, y2] = at(66, to);
  return `M ${f(x1)} ${f(y1)} A 66 66 0 0 ${sweep} ${f(x2)} ${f(y2)}`;
};
const stems = [arc(100, 200, 1), arc(80, -20, 0)];

// Four stars on an arc above the shield.
const star = (cx: number, cy: number, r: number) => {
  const pts = Array.from({ length: 10 }, (_, i) => {
    const rr = i % 2 ? r * 0.45 : r;
    const a = rad(-90 + i * 36);
    return `${f(cx + rr * Math.cos(a))},${f(cy + rr * Math.sin(a))}`;
  });
  return pts.join(' ');
};
const stars = [246, 261, 279, 294].map((deg) => {
  const [x, y] = at(68.5, deg);
  return star(x, y, 4.4);
});
const [lx, ly] = at(100, 180);
const [rx, ry] = at(100, 0);
---

<svg
  class:list={['insignia', cls]}
  viewBox="0 0 240 240"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <radialGradient id={`ins-field-${uid}`} cx="50%" cy="42%" r="60%">
      <stop offset="0" stop-color="#1b2f49"></stop>
      <stop offset="1" stop-color="#0f1b2d"></stop>
    </radialGradient>
    <linearGradient id={`ins-shield-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1d3252"></stop>
      <stop offset="1" stop-color="#132238"></stop>
    </linearGradient>
    <path id={`ins-top-${uid}`} d="M 26,120 A 94,94 0 0 1 214,120"></path>
    <path id={`ins-bot-${uid}`} d="M 14,120 A 106,106 0 0 0 226,120"></path>
  </defs>

  <circle cx="120" cy="120" r="118" fill="#b37a14"></circle>
  <circle cx="120" cy="120" r="116" fill="#f2b33d"></circle>
  <circle cx="120" cy="120" r="112.5" fill="#0b1422"></circle>
  <circle
    cx="120"
    cy="120"
    r="109.5"
    fill="none"
    stroke="#eef2f7"
    stroke-opacity="0.32"
    stroke-width="1.2"
    stroke-dasharray="3 3.2"></circle>

  <text class="ins-text ins-top" fill="#eef2f7" font-size="15.5" letter-spacing="2.4">
    <textPath href={`#ins-top-${uid}`} startOffset="50%" text-anchor="middle">AHMAD WHO SECURES</textPath>
  </text>
  <text class="ins-text ins-bot" fill="#f2b33d" font-size="13" letter-spacing="3.4">
    <textPath href={`#ins-bot-${uid}`} startOffset="50%" text-anchor="middle">SEMPER PROBA</textPath>
  </text>
  <polygon points={star(lx, ly, 6)} fill="#f2b33d"></polygon>
  <polygon points={star(rx, ry, 6)} fill="#f2b33d"></polygon>

  <circle cx="120" cy="120" r="86" fill="none" stroke="#f2b33d" stroke-width="2"></circle>
  <circle cx="120" cy="120" r="84" fill={`url(#ins-field-${uid})`}></circle>

  <g class="ins-bezel">
    {
      ticks.map((t) => (
        <line
          x1={f(t.x1)}
          y1={f(t.y1)}
          x2={f(t.x2)}
          y2={f(t.y2)}
          stroke={t.long ? '#f2b33d' : '#8fa3bc'}
          stroke-opacity={t.long ? 1 : 0.55}
          stroke-width={t.long ? 1.8 : 1}
          stroke-linecap="round"
        />
      ))
    }
  </g>

  {stems.map((d) => <path d={d} fill="none" stroke="#b37a14" stroke-width="1.6" stroke-linecap="round" />)}
  {
    leaves.map((l) => (
      <ellipse
        cx={f(l.x)}
        cy={f(l.y)}
        rx="7.2"
        ry="2.6"
        transform={`rotate(${f(l.rot)} ${f(l.x)} ${f(l.y)})`}
        fill={l.tone === 'a' ? '#f2b33d' : '#b37a14'}
      />
    ))
  }
  <path d="M120 178.5l3.2 3.2-3.2 3.2-3.2-3.2z" fill="#f2b33d"></path>

  {stars.map((p) => <polygon points={p} fill="#f2b33d" />)}

  <path
    d="M120 68 L158 81 V117 C158 141 143 160 120 171 C97 160 82 141 82 117 V81 Z"
    fill={`url(#ins-shield-${uid})`}
    stroke="#f2b33d"
    stroke-width="2.6"
    stroke-linejoin="round"></path>
  <path
    d="M120 75 L151 85.5 V117 C151 137 139 153 120 162.5 C101 153 89 137 89 117 V85.5 Z"
    fill="none"
    stroke="#eef2f7"
    stroke-opacity="0.24"
    stroke-width="1"
    stroke-dasharray="2 2.5"
    stroke-linejoin="round"></path>

  <g class="ins-mark">
    <path d="M106 99 H124 L134 109 V137 H106 Z" fill="#f2b33d"></path>
    <path d="M124 99 V109 H134 Z" fill="#b37a14"></path>
    <path
      d="M111.5 119.5 L117.5 125.5 L128.5 113.5"
      fill="none"
      stroke="#0f1b2d"
      stroke-width="3.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>
</svg>
