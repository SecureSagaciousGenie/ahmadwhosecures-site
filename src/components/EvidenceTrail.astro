---
// Author: Ahmad Shaukat
// Hero panel: how one requirement is traced to a control, a typical build and the evidence an
// assessor opens. It shows the method only: builds are generic patterns, not any client environment.
// The picker is a radio group, so it works without JavaScript; the script only adds autoplay.
const items = [
  {
    id: '3.5.3',
    title: 'Multifactor authentication',
    cmmc: 'IA.L2-3.5.3',
    control: 'Every account signs in with MFA, and admin access needs a method that cannot be phished.',
    build:
      'Conditional Access: MFA for all users, a phishing-resistant method for admin roles and admin portals, and legacy authentication blocked.',
    files: ['policy-export.json', 'report-only-results.csv', 'signin-log-sample.csv'],
    check: 'Checked for every account type, admins included',
  },
  {
    id: '3.1.1',
    title: 'Authorized access',
    cmmc: 'AC.L2-3.1.1',
    control: 'Only named accounts get in, and access depends on role and device as well as the password.',
    build:
      'Unique named identities, break-glass accounts excluded through one documented group, and access rules by role and device.',
    files: ['account-review.xlsx', 'exclusion-groups.csv', 'access-rules.md'],
    check: 'Checked against the HR list and every exclusion',
  },
  {
    id: '3.3.1',
    title: 'System audit logs',
    cmmc: 'AU.L2-3.3.1',
    control: 'Logs that show who did what, kept for a retention period the SSP states.',
    build:
      'A SIEM fed by endpoint telemetry such as Sysmon and the core Windows event channels, with retention sized to the SSP.',
    files: ['agent-coverage.csv', 'retention-policy.json', 'ssp-statement.docx'],
    check: 'Checked from an alert back to the raw event',
  },
  {
    id: '3.6.1',
    title: 'Incident handling',
    cmmc: 'IR.L2-3.6.1',
    control: 'A tested way to run an incident from first alert to closed case.',
    build:
      'Case management, a written triage runbook, and evidence collection practised against known plants on a lab machine.',
    files: ['ir-runbook.pdf', 'case-template.json', 'exercise-record.txt'],
    check: 'Checked by walking a test incident end to end',
  },
  {
    id: '3.13.11',
    title: 'FIPS-validated cryptography',
    cmmc: 'SC.L2-3.13.11',
    control: 'Cryptography that protects CUI uses validated modules, each one named by certificate.',
    build: 'Validated modules wherever CUI is stored or sent, listed on a reference sheet with their CMVP certificate numbers.',
    files: ['fips-reference.xlsx', 'cmvp-certificates.pdf', 'ssp-statement.docx'],
    check: 'Checked by certificate number, not product name',
  },
];
---

<div class="trail-wrap">
  <section class="trail" aria-labelledby="trail-title" data-trail>
    <div class="trail-top">
      <h2 class="trail-title" id="trail-title">From requirement to evidence</h2>
      <p class="trail-src">NIST SP 800-171 Rev 2</p>
    </div>

    <fieldset class="trail-picker">
      <legend class="sr-only">Choose a requirement</legend>
      {
        items.map((it, i) => (
          <label class="trail-opt">
            <input type="radio" name="trail-req" value={String(i)} checked={i === 0} />
            <span class="trail-key">
              <span>{it.id}</span>
              <span class="trail-bar" aria-hidden="true">
                <i />
              </span>
            </span>
          </label>
        ))
      }
    </fieldset>

    {
      items.map((it, i) => (
        <div class="trail-panel" data-panel={String(i)}>
          <ol class="ts-list">
            <li class="ts" style="--i:0">
              <span class="ts-k">Requirement</span>
              <div class="ts-req">
                <span class="ts-id">{it.id}</span>
                <span class="ts-title">{it.title}</span>
                <span class="ts-tag">{it.cmmc}</span>
              </div>
            </li>
            <li class="ts" style="--i:1">
              <span class="ts-k">Control</span>
              <p class="ts-v">{it.control}</p>
            </li>
            <li class="ts" style="--i:2">
              <span class="ts-k">Typical build</span>
              <p class="ts-v">{it.build}</p>
            </li>
            <li class="ts" style="--i:3">
              <span class="ts-k">Evidence an assessor opens</span>
              <ul class="ts-files">
                {it.files.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </li>
          </ol>
          <div class="trail-foot">
            <p class="trail-scope">{it.check}</p>
            <p class="stamp">Traced</p>
          </div>
        </div>
      ))
    }
  </section>
  <p class="trail-note">
    The mapping reflects my reading of NIST SP 800-171 Rev 2 and the CMMC Level 2 assessment guidance; it is not legal
    advice. Builds are typical patterns and file names are illustrative; neither describes a client environment.
  </p>
</div>
