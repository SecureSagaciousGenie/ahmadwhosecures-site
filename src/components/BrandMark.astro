---
// Author: Ahmad Shaukat
// The mark: a shield with an electric-blue rim and an amber keyhole, matching the background art.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class={cls} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="bm-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1d3d6b"></stop>
      <stop offset="1" stop-color="#0b1627"></stop>
    </linearGradient>
    <linearGradient id="bm-rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9ad0ff"></stop>
      <stop offset="1" stop-color="#3d8bff"></stop>
    </linearGradient>
  </defs>
  <path
    d="M16 2 L27.5 6.2 V14.6 C27.5 21.4 22.8 26.6 16 30 C9.2 26.6 4.5 21.4 4.5 14.6 V6.2 Z"
    fill="url(#bm-fill)"
    stroke="url(#bm-rim)"
    stroke-width="1.8"
    stroke-linejoin="round"></path>
  <path
    d="M16 5.6 L24.3 8.6 V14.8 C24.3 19.9 20.9 23.9 16 26.5 C11.1 23.9 7.7 19.9 7.7 14.8 V8.6 Z"
    fill="none"
    stroke="#5aaaff"
    stroke-opacity="0.38"
    stroke-width="0.8"></path>
  <circle cx="16" cy="13.2" r="3.1" fill="#f2b33d"></circle>
  <path d="M14.5 15.2 H17.5 L18.4 21 H13.6 Z" fill="#f2b33d"></path>
</svg>
