---
// Author: Ahmad Shaukat
// Case files: each case study as an alert-style panel with severity bar, status and frameworks.
import Status from './Status.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'work'>[];
}
const { items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="cases">
  {
    items.map((item, i) => (
      <li class="panel case" data-status={item.data.status} data-reveal style={`--reveal-delay:${i * 0.07}s`}>
        <div>
          <p class="case-id">
            <b>CASE-{pad(i + 1)}</b> // {item.data.setting} // {item.data.period}
          </p>
          <h3>
            <a href={`/work/${item.id}/`}>{item.data.claim}</a>
          </h3>
          <p class="open" aria-hidden="true">
            &gt;&gt; open case file
          </p>
        </div>
        <p class="case-evidence">{item.data.evidence}</p>
        <div class="case-meta">
          <Status status={item.data.status} />
          <ul class="chips" aria-label="Frameworks and tools">
            {item.data.frameworks.map((f) => (
              <li class="chip">{f}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>
