---
// Author: Ahmad Shaukat
// Line icons drawn on a 24px grid. Decorative only; the text beside them carries the meaning.
type Name = 'arrow' | 'search' | 'sun' | 'moon' | 'check' | 'block' | 'shield' | 'scan' | 'report' | 'clean' | 'terminal';

interface Props {
  name: Name;
  class?: string;
}

const { name, class: cls } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4.5 12h15M13.5 6l6 6-6 6" />}
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="M20 20l-4.2-4.2" />
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M4.6 4.6L6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
      </>
    )
  }
  {name === 'moon' && <path d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.8 7.8 0 1 0 10.1 10.1z" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {
    name === 'block' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M6 6l12 12" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 3l7.5 3v5.5c0 4.3-3 7.9-7.5 9.5-4.5-1.6-7.5-5.2-7.5-9.5V6z" />
        <path d="M8.8 12.2l2.2 2.2 4.4-4.6" />
      </>
    )
  }
  {
    name === 'scan' && (
      <>
        <path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16" />
        <circle cx="12" cy="12" r="3.2" />
      </>
    )
  }
  {
    name === 'report' && (
      <>
        <path d="M7 3h7l4.5 4.5V21H7z" />
        <path d="M14 3v4.5h4.5M10 12.5h5.5M10 16.5h5.5" />
      </>
    )
  }
  {
    name === 'clean' && (
      <>
        <path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13" />
        <path d="M10.5 11v5.5M13.5 11v5.5" />
      </>
    )
  }
  {
    name === 'terminal' && (
      <>
        <rect x="3.5" y="4.5" width="17" height="15" rx="1.5" />
        <path d="M7.5 9.5l3 2.5-3 2.5M12.5 15h4" />
      </>
    )
  }
</svg>
