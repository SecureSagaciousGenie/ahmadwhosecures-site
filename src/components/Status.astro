---
// Author: Ahmad Shaukat
// Severity-style status pill. In progress pulses amber; Implemented is green; Shipped is cyan.
interface Props {
  status: 'Implemented' | 'In progress' | 'Shipped';
  label?: string;
  note?: string;
}
const { status, label, note } = Astro.props;
---

<div>
  <span class="status" data-status={status}><span class="pulse-dot" aria-hidden="true"></span>{label ?? status}</span>
  {note && <p class="status-note">{note}</p>}
</div>
