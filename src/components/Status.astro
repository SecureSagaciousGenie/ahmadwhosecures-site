---
// Author: Ahmad Shaukat
// Status pill in assessment language: Implemented and Shipped are green, In progress is blue.
interface Props {
  status: string;
  label?: string;
}

const { status, label } = Astro.props;
const key = status.toLowerCase().replace(/\s+/g, '-');
---

<span class="status" data-status={key}>{label ?? status}</span>
