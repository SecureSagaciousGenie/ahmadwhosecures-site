---
// Author: Ahmad Shaukat
// Field notes as a dated list.
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'writing'>[];
}

const { items } = Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const label = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const minutes = (body = '') => Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 220));
---

<ol class="notes">
  {
    items.map((item) => (
      <li class="note-row reveal">
        <a class="note-link" href={`/writing/${item.id}/`} data-glow>
          <time class="note-date" datetime={iso(item.data.date)}>
            {label(item.data.date)}
          </time>
          <span>
            <span class="note-title">{item.data.title}</span>
            <span class="note-desc">{item.data.description}</span>
          </span>
          <span class="note-side">
            <span class="note-topic">{item.data.topics[0]}</span>
            <span class="note-time">{minutes(item.body)} min read</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>
