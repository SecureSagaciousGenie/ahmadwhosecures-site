---
// Author: Ahmad Shaukat
// Section heading: a label saying what kind of section it is, the title, and a short note.
import Icon from './Icon.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  link?: { href: string; label: string };
}

const { id, eyebrow, title, link } = Astro.props;
---

<div class="shead">
  <p class="eyebrow"><span class="eyebrow-mark"></span>{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  <div class="shead-side">
    <slot />
    {
      link && (
        <a class="arrow-link" href={link.href}>
          {link.label}
          <Icon name="arrow" />
        </a>
      )
    }
  </div>
</div>
