---
// Author: Ahmad Shaukat
// Claims and evidence ledger. Each row is a case study: the claim, the evidence and its status.
import Status from './Status.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'work'>[];
}
const { items } = Astro.props;
---

<div class="ledger-wrap">
  <div class="ledger-header" aria-hidden="true">
    <span>Claim:</span>
    <span>Evidence:</span>
    <span>Status:</span>
  </div>
  <ul class="ledger">
    {
      items.map((item) => (
        <li class="ledger-row">
          <div class="ledger-claim">
            <span class="cell-label">Claim:</span>
            <h3>
              <a href={`/work/${item.id}/`}>{item.data.claim}</a>
            </h3>
            <p class="ledger-setting">
              {item.data.setting}, {item.data.period}
            </p>
          </div>
          <div>
            <span class="cell-label">Evidence:</span>
            <p class="ledger-evidence">{item.data.evidence}</p>
          </div>
          <div class="ledger-meta">
            <span class="cell-label">Status:</span>
            <Status status={item.data.status} note={item.data.statusNote} />
            <p class="frameworks">{item.data.frameworks.join(', ')}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
