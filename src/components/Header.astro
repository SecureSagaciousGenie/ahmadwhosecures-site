---
// Author: Ahmad Shaukat
// Site header: mark, navigation, search and theme. The search and theme buttons stay hidden
// until JavaScript can run them; navigation never depends on it.
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { site, nav } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="hdr" data-header>
  <div class="container hdr-row">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <BrandMark class="brand-mark" />
      <span>
        <span class="brand-name">{site.name}</span>
        <span class="brand-handle">{site.handle}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr-actions">
      <button
        class="icon-btn palette-btn"
        type="button"
        aria-label="Search pages and articles"
        aria-keyshortcuts="Control+K Meta+K"
        data-palette-open
        hidden
      >
        <Icon name="search" />
        <span class="palette-label">Search</span>
        <kbd data-palette-kbd>Ctrl K</kbd>
      </button>
      <button
        class="icon-btn theme-btn"
        type="button"
        aria-label="Switch to light theme"
        aria-pressed="false"
        data-theme-toggle
        hidden
      >
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
    </div>
  </div>
</header>
