---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import { site } from '../site.config';

const experience = [
  {
    setting: 'US defense contractor',
    role: 'Principal Information Security Engineer, first and only security hire',
    work: 'Security and compliance program: CMMC Level 1 and Level 2, NIST SP 800-171, DFARS, ISO/IEC 27001:2022. DFIR, SIEM, endpoint baseline, MS 365 migration and identity design.',
  },
  {
    setting: 'Managed service provider',
    role: 'Technical Consultant, SOC operations',
    work: 'Secureworks Taegis XDR operations across three financial-services client accounts, with oversight of L1 to L3 tiers.',
  },
  {
    setting: 'Technology services',
    role: 'DevOps and Network Engineer',
    work: 'Hardened golden-image pipeline built with Packer, Terraform and Ansible.',
  },
  {
    setting: 'Network services provider',
    role: 'Network Engineer',
    work: 'Network engineering in telecommunications carrier and data centre environments.',
  },
];

const creds = [
  { name: 'Bachelor of Information Technology (Network Security), TAFE NSW', status: 'Completed', when: '' },
  { name: 'ISC2 Certified in Cybersecurity', status: 'Scheduled', when: 'Exam booked for late 2026' },
  { name: 'Risk Management Framework (RMF) course', status: 'In progress', when: '' },
  { name: 'CISSP', status: 'Planned', when: 'Target: 2027' },
];

const toolset = [
  ['Compliance', 'CMMC 2.0, NIST SP 800-171 Rev 2 and Rev 3, DFARS 252.204-7012, ISO/IEC 27001:2022, ISO 19011 internal audit'],
  ['Identity and cloud', 'Entra ID Conditional Access, Intune, MS Defender, Exchange Online, Autopilot'],
  ['Detection', 'Wazuh, Sysmon, TheHive, Cortex, MISP, Secureworks Taegis XDR'],
  ['DFIR', "KAPE, Eric Zimmerman's tools, THOR Lite, Hayabusa, Chainsaw, SIFT"],
  ['Endpoint and automation', 'Action1 RMM, PowerShell, Packer, Terraform, Ansible'],
  ['Network', 'OPNsense, Zenarmor, enterprise firewalls in FIPS mode, carrier and data centre routing'],
];
---

<Base
  title="About"
  description="Ahmad Shaukat: principal information security engineer working across CMMC, NIST SP 800-171, ISO 27001, DFIR, SOC operations, DevOps and network engineering."
>
  <div class="container">
    <header class="phead">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li aria-current="page">About</li>
      </ol>
      <h1>About</h1>
      <p class="lede">
        I am a principal information security engineer. I work as the only security practitioner at a US defense
        contractor, so the controls I build and the evidence behind them are both mine to answer for.
      </p>
    </header>

    <section class="about-grid doc-after" aria-labelledby="how-title">
      <div class="prose">
        <h2 id="how-title">How I work</h2>
        <p>
          I start from the evidence an assessor or an incident responder will ask for, then work back to the control that
          produces it. A control that cannot show its own evidence is a gap, whatever the policy says.
        </p>
        <p>
          I prefer changes that can be undone. Hardening that breaks a business process tends to get rolled back in a hurry
          and not reapplied. Rollback plans, before-state backups and report-only phases are part of the build, not an
          afterthought.
        </p>
        <p>
          I write decisions down with their trade-offs. Most security choices in a small business are a balance between
          cost, user friction and risk. The record of why a choice was made is often worth more in an assessment than the
          choice itself.
        </p>
      </div>

      <aside class="now" aria-labelledby="now-title">
        <p class="eyebrow"><span class="eyebrow-mark"></span>Now and next</p>
        <h2 id="now-title" class="sr-only">Now and next</h2>
        <p style="margin-top: 1rem">
          Current work covers a CMMC Level 2 enclave build, a Google Workspace to MS 365 migration with a new identity
          baseline, and an on-prem SIEM and DFIR stack.
        </p>
        <p>
          I also build open-source tooling, starting with <a href="/tools/">Win11-Security-Optimizer</a>, and do
          independent security research under the handle {site.handle}.
        </p>
        <p>From 2027 I plan to offer fractional security advisory work to small defense industrial base contractors.</p>
      </aside>
    </section>

    <section class="doc-after" aria-labelledby="exp-title">
      <p class="eyebrow"><span class="eyebrow-mark"></span>Career</p>
      <h2 class="subhead" id="exp-title">Experience</h2>
      <ol class="xp">
        {
          experience.map((e) => (
            <li class="reveal">
              <p class="xp-setting">{e.setting}</p>
              <div>
                <h3 class="xp-role">{e.role}</h3>
                <p class="xp-work">{e.work}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="fine" style="margin-top: 0">
        Employers are described by industry. Dates and detail are on <a href={site.linkedin} rel="me noopener">LinkedIn</a>.
      </p>
    </section>

    <section class="split-2 doc-after" aria-label="Credentials and toolset">
      <div>
        <p class="eyebrow"><span class="eyebrow-mark"></span>Education</p>
        <h2 class="subhead">Credentials</h2>
        <ul class="cred">
          {
            creds.map((c) => (
              <li>
                <span>
                  <span class="cred-name">{c.name}</span>
                  {c.when && <span class="cred-when">{c.when}</span>}
                </span>
                <Status status={c.status} />
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow"><span class="eyebrow-mark"></span>Toolset</p>
        <h2 class="subhead">What I work with</h2>
        <dl class="kit">
          {
            toolset.map(([area, tools]) => (
              <div>
                <dt>{area}</dt>
                <dd>{tools}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </div>
</Base>
