---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
import Decrypt from '../components/Decrypt.astro';
import Status from '../components/Status.astro';
import { site } from '../site.config';

const experience = [
  {
    setting: 'US defense contractor',
    role: 'Principal Information Security Engineer, first and only security hire',
    work: 'Security and compliance program: CMMC Level 1 and Level 2, NIST SP 800-171, DFARS, ISO/IEC 27001:2022. DFIR, SIEM, endpoint baseline, MS 365 migration and identity design.',
  },
  {
    setting: 'Managed service provider',
    role: 'Technical Consultant, SOC operations',
    work: 'Secureworks Taegis XDR operations across three financial-services client accounts, with oversight of L1 to L3 tiers.',
  },
  {
    setting: 'Technology services',
    role: 'DevOps and Network Engineer',
    work: 'Hardened golden-image pipeline built with Packer, Terraform and Ansible.',
  },
  {
    setting: 'Network services provider',
    role: 'Network Engineer',
    work: 'Network engineering in telecommunications carrier and data centre environments.',
  },
];

const creds: Array<[string, 'Implemented' | 'In progress' | 'Shipped', string]> = [
  ['Bachelor of Information Technology (Network Security), TAFE NSW', 'Implemented', 'Completed'],
  ['ISC2 Certified in Cybersecurity', 'In progress', 'Exam scheduled, late 2026'],
  ['Risk Management Framework (RMF) course', 'In progress', 'In progress'],
  ['CISSP', 'Shipped', 'Planned, 2027'],
];

const toolset = [
  ['Compliance', 'CMMC 2.0, NIST SP 800-171 Rev 2 and Rev 3, DFARS 252.204-7012, ISO/IEC 27001:2022, ISO 19011 internal audit'],
  ['Identity and cloud', 'Entra ID Conditional Access, Intune, MS Defender, Exchange Online, Autopilot'],
  ['Detection', 'Wazuh, Sysmon, TheHive, Cortex, MISP, Secureworks Taegis XDR'],
  ['DFIR', "KAPE, Eric Zimmerman's tools, THOR Lite, Hayabusa, Chainsaw, SIFT"],
  ['Endpoint and automation', 'Action1 RMM, PowerShell, Packer, Terraform, Ansible'],
  ['Network', 'OPNsense, Zenarmor, enterprise firewalls in FIPS mode, carrier and data centre routing'],
];
---

<Base
  title="About"
  description="Ahmad Shaukat: principal information security engineer working across CMMC, NIST SP 800-171, ISO 27001, DFIR, SOC operations, DevOps and network engineering."
>
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">~</a>/about</p>
      <h1><Decrypt text="About" /></h1>
      <p class="lede">
        I am a principal information security engineer. I work as the only security practitioner at a US defense
        contractor, so the controls I build and the evidence behind them are both mine to answer for.
      </p>
    </header>

    <div class="split">
      <section class="panel hud card" data-reveal aria-labelledby="how-title">
        <p class="card-label">cat ./method</p>
        <h2 id="how-title" style="font-size: var(--step-2)">How I work</h2>
        <p>
          I start from the evidence an assessor or an incident responder will ask for, then work back to the control
          that produces it. A control that cannot show its own evidence is a gap, whatever the policy says.
        </p>
        <p>
          I prefer changes that can be undone. Hardening that breaks a business process tends to get rolled back in a
          hurry and not reapplied. Rollback plans, before-state backups and report-only phases are part of the build,
          not an afterthought.
        </p>
        <p>
          I write decisions down with their trade-offs. Most security choices in a small business are a balance between
          cost, user friction and risk. The record of why a choice was made is often worth more in an assessment than
          the choice itself.
        </p>
      </section>

      <section class="panel card" data-reveal style="--reveal-delay: 0.08s" aria-labelledby="now-title">
        <p class="card-label">cat ./now</p>
        <h2 id="now-title" style="font-size: var(--step-2)">Now and next</h2>
        <p>
          Current work covers a CMMC Level 2 enclave build, a Google Workspace to MS 365 migration with a new identity
          baseline, and an on-prem SIEM and DFIR stack.
        </p>
        <p>
          I also build open-source tooling, starting with <a href="/tools/">Win11-Security-Optimizer</a>, and do
          independent security research under the handle {site.handle}.
        </p>
        <p>From 2027 I plan to offer fractional security advisory work to small defense industrial base contractors.</p>
      </section>
    </div>

    <section class="section" aria-labelledby="exp-title">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">history | head</p>
          <h2 id="exp-title"><Decrypt text="Experience" /></h2>
        </div>
        <p>Described by industry. Detail is on LinkedIn.</p>
      </div>
      <ol class="timeline">
        {
          experience.map((e, i) => (
            <li data-reveal style={`--reveal-delay:${i * 0.08}s`}>
              <p class="tl-setting">{e.setting}</p>
              <h3>{e.role}</h3>
              <p>{e.work}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="cred-title">
      <div class="split">
        <div class="panel card" data-reveal>
          <p class="card-label">ls ./credentials</p>
          <h2 id="cred-title" style="font-size: var(--step-2)">Education and credentials</h2>
          <ul class="cred-list">
            {
              creds.map(([name, status, label]) => (
                <li>
                  <span>{name}</span>
                  <Status status={status} label={label} />
                </li>
              ))
            }
          </ul>
        </div>
        <div class="panel card" data-reveal style="--reveal-delay: 0.08s">
          <p class="card-label">which --all</p>
          <h2 style="font-size: var(--step-2)">Working toolset</h2>
          <ul class="cred-list">
            {
              toolset.map(([area, tools]) => (
                <li style="display: block">
                  <span class="card-label" style="display: block">{area}</span>
                  <span>{tools}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>
