---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
import CaseFiles from '../components/CaseFiles.astro';
import EntryList from '../components/EntryList.astro';
import ThreatMap from '../components/ThreatMap.astro';
import Decrypt from '../components/Decrypt.astro';
import { getCollection } from 'astro:content';
import { byNewest } from '../lib/sort';
import { site } from '../site.config';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort(byNewest).slice(0, 5);

const roles = [
  'Principal Information Security Engineer',
  'CMMC  |  NIST SP 800-171  |  ISO 27001',
  'SIEM  |  DFIR  |  identity and endpoint',
  'Open-source security tooling',
];
---

<Base>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="kicker">whoami</p>
        <h1 id="hero-title" class="morph" data-morph data-state="name">
          <span class="sr-only">Ahmad Shaukat</span>
          <button
            type="button"
            class="morph-btn"
            aria-pressed="false"
            aria-label="Show the handle: ahmad who secures"
            title="ahmad who secures"
            data-morph-btn
          >
            <span class="morph-line" aria-hidden="true"
              ><span class="decrypt" data-decrypt data-text="Ahmad">Ahmad</span><span
                class="morph-who"
                data-morph-who></span></span
            >
            <span class="accent-line" aria-hidden="true"
              ><span class="decrypt" data-decrypt data-text="S">S</span><span
                class="decrypt"
                data-decrypt
                data-text="haukat"
                data-morph-tail>haukat</span></span
            >
          </button>
        </h1>
        <p class="hero-role">
          <span class="sr-only">{site.role}</span>
          <span aria-hidden="true" data-typer={JSON.stringify(roles)}>{roles[0]}</span><span
            class="caret"
            aria-hidden="true"></span>
        </p>
        <p class="hero-statement">
          I build security programs for US defense contractors and keep the evidence an assessor will ask to see.
        </p>
        <p class="hero-detail">
          I am the only security engineer at a defense contractor of about 80 users. I cover CMMC, NIST SP 800-171 and
          ISO 27001. I also run detection and response, plus the migrations that sit underneath all of it. Earlier work
          was in SOC operations, DevOps and carrier network engineering.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/work/">Open the case files</a>
          <a class="btn btn-ghost" href="/writing/">Read field notes</a>
        </div>
        <div class="hero-social">
          <a href={site.linkedin} target="_blank" rel="me noopener">linkedin/ahmadshkt</a>
          <a href={site.github} target="_blank" rel="me noopener">github/SecureSagaciousGenie</a>
          <span>{site.location}</span>
        </div>
      </div>
      <ThreatMap />
    </section>

    <section class="section" aria-labelledby="cases-title">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">ls ./case-files</p>
          <h2 id="cases-title"><Decrypt text="Case files" /></h2>
        </div>
        <p>
          Each claim links to the write-up behind it. Status uses assessment language: implemented means in place with
          evidence; in progress means designed, with the build under way.
        </p>
      </div>
      <CaseFiles items={work} />
    </section>

    <section class="section" aria-labelledby="notes-title">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">tail -f ./field-notes</p>
          <h2 id="notes-title"><Decrypt text="Field notes" /></h2>
        </div>
        <p>Write-ups from the work above. Lab data and sanitised detail only.</p>
      </div>
      <EntryList items={writing} />
    </section>
  </div>
</Base>
