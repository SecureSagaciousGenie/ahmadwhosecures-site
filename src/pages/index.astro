---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
import NameMorph from '../components/NameMorph.astro';
import EvidenceTrail from '../components/EvidenceTrail.astro';
import LabWindows from '../components/LabWindows.astro';
import LabTicker from '../components/LabTicker.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseLedger from '../components/CaseLedger.astro';
import SignInSim from '../components/SignInSim.astro';
import ChangeRecord from '../components/ChangeRecord.astro';
import EntryList from '../components/EntryList.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { byNewest } from '../lib/sort';
import { site } from '../site.config';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort(byNewest).slice(0, 5);

const facts = [
  {
    label: 'Frameworks, one evidence trail',
    value: '4',
    note: 'CMMC, NIST SP 800-171, DFARS 252.204-7012 and ISO/IEC 27001:2022.',
  },
  {
    label: 'NIST SP 800-171 requirements',
    value: '110',
    note: 'Each one traced from SSP statement to policy, implementation and evidence.',
  },
  {
    label: 'Fixes, each with a risk tier',
    value: '27',
    note: 'In Win11-Security-Optimizer v1.2.0, my open-source hardening tool. 26 write their own undo step; the 27th updates Defender signatures.',
  },
  {
    label: 'Pester tests in CI',
    value: '327',
    note: 'Run on Windows PowerShell 5.1, plus integration on a real Windows runner.',
  },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="art" data-art="hero" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span>{site.role}</p>
        <NameMorph />
        <p class="hero-lead">
          I build security programs for US defense contractors and keep the evidence an assessor will ask to see.
        </p>
        <p class="hero-body">
          I lead security engineering at a US defense contractor. I cover CMMC, NIST SP 800-171 and ISO 27001, run
          detection and response, and own the identity and mail migrations underneath them. Earlier roles were in SOC
          operations, DevOps and carrier network engineering.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/work/">Open the case files<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="/writing/">Read the field notes</a>
        </div>
        <ul class="hero-links">
          <li><a href={site.linkedin} rel="me noopener">linkedin/ahmadshkt</a></li>
          <li><a href={site.github} rel="me noopener">github/SecureSagaciousGenie</a></li>
          <li>{site.location}</li>
        </ul>
      </div>
      <div class="hero-visual" data-lab>
        <LabWindows />
        <EvidenceTrail />
      </div>
    </div>
  </section>

  <section class="facts" aria-label="Selected figures">
    <LabTicker />
    <div class="container">
      <dl class="facts-grid">
        {
          facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd class="fact-value">
                {f.prefix && <small>{f.prefix}</small>}
                {f.value}
              </dd>
              <dd class="fact-note">{f.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="cases-title">
    <div class="container">
      <SectionHead id="cases-title" eyebrow="Ledger" title="Case files" link={{ href: '/work/', label: 'All case files' }}>
        <p>
          Each case covers the problem, the decisions and their trade-offs, and the parts that carry over to other
          environments. Client detail is generalised: no names, counts, dates or configuration that would map an
          environment.
        </p>
      </SectionHead>
      <CaseLedger items={work} />
    </div>
  </section>

  <section class="section section-band" aria-labelledby="sim-title">
    <div class="container">
      <SectionHead id="sim-title" eyebrow="Interactive" title="How a sign-in gets decided">
        <p>
          Pick who is signing in, from where, on what and to what. The panel runs a textbook Conditional Access policy set
          and shows which policies applied, which one decided, and why.
        </p>
      </SectionHead>
      <SignInSim />
    </div>
  </section>

  <section class="section" aria-labelledby="oss-title">
    <div class="container oss">
      <div class="oss-copy">
        <p class="eyebrow"><span class="eyebrow-mark"></span>Open source</p>
        <h2 id="oss-title">Win11-Security-Optimizer</h2>
        <p>
          A Windows 11 hardening and triage tool for people who own the machine but do not live in PowerShell. It runs from
          a batch file on the PowerShell 5.1 that ships with Windows, so there is no installer and no unsigned binary for
          SmartScreen to quarantine.
        </p>
        <p>
          Each change is backed up before it applies and read back after, and a rollback script can undo it. Third-party
          DFIR tools are opt-in and must match a pinned SHA-256 before they run.
        </p>
        <dl class="oss-stats">
          <div><dt>Current release, 21 Oct 2026</dt><dd>v1.2.0</dd></div>
          <div><dt>Fixes, each with a risk tier</dt><dd>27</dd></div>
          <div><dt>Pester tests in CI</dt><dd>327</dd></div>
          <div><dt>Licence; no bundled third-party program</dt><dd>MIT</dd></div>
        </dl>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/tools/">How it works<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="https://github.com/SecureSagaciousGenie/Win11-Security-Optimizer" rel="noopener"
            >Source on GitHub</a
          >
        </div>
      </div>
      <ChangeRecord />
    </div>
  </section>

  <section class="section section-band" aria-labelledby="notes-title">
    <div class="container">
      <SectionHead
        id="notes-title"
        eyebrow="Writing"
        title="Field notes"
        link={{ href: '/writing/', label: 'All field notes' }}
      >
        <p>
          Write-ups from production work, rewritten so the lesson travels and the client detail does not. Commands and
          configuration come from lab builds unless stated.
        </p>
      </SectionHead>
      <EntryList items={writing} />
    </div>
  </section>

  <section class="section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-box">
        <div>
          <p class="eyebrow"><span class="eyebrow-mark"></span>Contact</p>
          <h2 id="cta-title" style="margin-top: 1rem">Talk about CMMC, identity or detection work</h2>
          <p>
            LinkedIn is the fastest way to reach me. I work remotely with US clients, and from 2027 I plan to offer
            fractional security advisory work to small defense industrial base contractors.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={site.linkedin} rel="me noopener">Message on LinkedIn<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="/contact/">Other channels</a>
        </div>
      </div>
    </div>
  </section>
</Base>
