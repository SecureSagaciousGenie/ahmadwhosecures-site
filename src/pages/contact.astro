---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
import Decrypt from '../components/Decrypt.astro';
import { site } from '../site.config';
---

<Base title="Contact" description="How to reach Ahmad Shaukat.">
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">~</a>/contact</p>
      <h1><Decrypt text="Contact" /></h1>
      <p class="lede">LinkedIn is the fastest way to reach me. I work with US clients, remotely.</p>
    </header>

    <div class="panel hud terminal" data-reveal style="max-width: 760px">
      <div class="codeblock-bar">
        <span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>contact.sh</span>
        <span>secure channel</span>
      </div>
      <div class="terminal-body">
        <p class="terminal-line">
          <span class="p">$</span> contact --linkedin<br />
          <a href={site.linkedin} target="_blank" rel="me noopener">linkedin.com/in/ahmadshkt</a>
          <span class="out">Messages and connection requests. Mention what you are working on.</span>
        </p>
        <p class="terminal-line">
          <span class="p">$</span> contact --github<br />
          <a href={site.github} target="_blank" rel="me noopener">github.com/SecureSagaciousGenie</a>
          <span class="out">Issues and pull requests on my open-source tools.</span>
        </p>
        {
          site.email && (
            <p class="terminal-line">
              <span class="p">$</span> contact --email
              <br />
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <span class="out">Email for anything longer.</span>
            </p>
          )
        }
        <p class="terminal-line">
          <span class="p">$</span> cat /.well-known/security.txt<br />
          <a href="/.well-known/security.txt" data-astro-reload>security.txt</a>
          <span class="out">To report a security issue with this site or my tools.</span>
        </p>
      </div>
    </div>
  </div>
</Base>
