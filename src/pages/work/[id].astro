---
// Author: Ahmad Shaukat
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import EntryList from '../../components/EntryList.astro';
import Decrypt from '../../components/Decrypt.astro';
import { getCollection, render } from 'astro:content';
import { byNewest } from '../../lib/sort';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const writing = (
  await getCollection('writing', ({ id, data }) => !data.draft && entry.data.related.includes(id))
).sort(byNewest);
const compliance = entry.data.frameworks.some((f) => /CMMC|800-171|27001|DFARS/.test(f));
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={entry.data.title} description={entry.data.evidence} type="article">
  <div class="read-progress" aria-hidden="true" data-read-progress></div>
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">~</a>/<a href="/work/">work</a>/{entry.id}</p>
      <h1><Decrypt text={entry.data.title} /></h1>
      <p class="lede">{entry.data.claim}</p>
      <div class="meta-row">
        <Status status={entry.data.status} />
        <span>{entry.data.setting}</span>
        <span>{entry.data.period}</span>
      </div>
    </header>

    <div class="doc">
      <article class="doc-main prose">
        <Content />
      </article>
      <aside class="doc-aside" aria-label="Case summary">
        <section class="panel hud aside-card" data-reveal>
          <h2>Case summary</h2>
          <dl>
            <div><dt>Status</dt><dd><Status status={entry.data.status} note={entry.data.statusNote} /></dd></div>
            <div><dt>Setting</dt><dd>{entry.data.setting}</dd></div>
            <div><dt>Period</dt><dd>{entry.data.period}</dd></div>
            <div>
              <dt>Frameworks and tools</dt>
              <dd>
                <ul class="chips">{entry.data.frameworks.map((f) => <li class="chip">{f}</li>)}</ul>
              </dd>
            </div>
          </dl>
        </section>
        {
          sections.length > 1 && (
            <section class="panel aside-card toc-card">
              <h2>Sections</h2>
              <ol class="toc" data-toc>
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        {
          sections.length > 1 && (
            <details class="panel toc-mobile">
              <summary>Sections ({sections.length})</summary>
              <ol class="toc" data-toc>
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
      </aside>
    </div>

    {
      writing.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <p class="kicker">grep -l related ./field-notes</p>
          <h2 id="related-title">Related field notes</h2>
          <EntryList items={writing} />
        </section>
      )
    }
    {
      compliance && (
        <p class="note">
          Compliance points here reflect my reading of published guidance and my own program work. They are not legal
          advice.
        </p>
      )
    }
  </div>
</Base>
