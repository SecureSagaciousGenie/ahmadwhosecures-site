---
// Author: Ahmad Shaukat
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import EntryList from '../../components/EntryList.astro';
import Patch from '../../components/Patch.astro';
import { getCollection, render } from 'astro:content';
import { byNewest } from '../../lib/sort';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({ params: { id: entry.id }, props: { entry, index: i + 1 } }));
}

const { entry, index } = Astro.props;
const { Content, headings } = await render(entry);
const writing = (
  await getCollection('writing', ({ id, data }) => !data.draft && entry.data.related.includes(id))
).sort(byNewest);
const compliance = entry.data.frameworks.some((f) => /CMMC|800-171|27001|DFARS/.test(f));
const sections = headings.filter((h) => h.depth === 2);
const caseId = `CF-${String(index).padStart(2, '0')}`;
---

<Base title={entry.data.title} description={entry.data.evidence} type="article">
  <div class="read-progress" aria-hidden="true" data-read-progress></div>
  <div class="container">
    <header class="phead phead-doc phead-patched">
      <Patch kind={entry.data.kind} size={92} class="phead-patch" />
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li><a href="/work/">Case files</a></li>
        <li aria-current="page">{caseId}</li>
      </ol>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.claim}</p>
      <div class="meta-row">
        {entry.data.status ? <Status status={entry.data.status} /> : <span class="kind">{entry.data.kind}</span>}
        <span>{entry.data.setting}</span>
        {entry.data.period && <span>{entry.data.period}</span>}
      </div>
    </header>

    <div class="doc">
      <aside class="doc-rail" aria-label="Case summary">
        <section class="rail-card">
          <h2>{caseId} summary</h2>
          <dl class="rail-dl">
            {
              entry.data.status && (
                <div>
                  <dt>Status</dt>
                  <dd>
                    <Status status={entry.data.status} />
                    {entry.data.statusNote && <p class="status-note">{entry.data.statusNote}</p>}
                  </dd>
                </div>
              )
            }
            <div><dt>In short</dt><dd>{entry.data.evidence}</dd></div>
            <div>
              <dt>Frameworks and tools</dt>
              <dd>
                <ul class="chips">
                  {
                    entry.data.frameworks.map((f) => (
                      <li class="chip">{f}</li>
                    ))
                  }
                </ul>
              </dd>
            </div>
          </dl>
        </section>
        {
          sections.length > 1 && (
            <nav class="rail-card toc toc-card" aria-label="Sections" data-toc>
              <h2>Sections</h2>
              <ol>
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          sections.length > 1 && (
            <details class="toc-mobile toc">
              <summary>Sections ({sections.length})</summary>
              <ol>
                {sections.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
      </aside>

      <article class="prose">
        <Content />
        {
          compliance && (
            <p class="fine">
              Compliance points here reflect my reading of published guidance and my own program work. They are not legal
              advice.
            </p>
          )
        }
      </article>
    </div>

    {
      writing.length > 0 && (
        <section class="related doc-after" aria-labelledby="related-title">
          <p class="eyebrow">
            <span class="eyebrow-mark" />
            Related
          </p>
          <h2 id="related-title">Field notes from this work</h2>
          <EntryList items={writing} />
        </section>
      )
    }
  </div>
</Base>
