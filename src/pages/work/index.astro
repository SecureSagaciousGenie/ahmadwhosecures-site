---
// Author: Ahmad Shaukat
import Base from '../../layouts/Base.astro';
import CaseFiles from '../../components/CaseFiles.astro';
import Decrypt from '../../components/Decrypt.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Case files"
  description="Case studies in defense-sector security: CMMC and NIST SP 800-171 program build, Google Workspace to MS 365 migration, SIEM and DFIR, endpoint baseline and an open-source hardening tool."
>
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">~</a>/work</p>
      <h1><Decrypt text="Case files" /></h1>
      <p class="lede">
        Each case covers the setting, the decisions and their trade-offs, and where the work stands today. Employers are
        described by industry. Detail that would map a client's environment stays out.
      </p>
    </header>
    <CaseFiles items={work} />
  </div>
</Base>
