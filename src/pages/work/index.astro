---
// Author: Ahmad Shaukat
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Work"
  description="Case studies in defense-sector security: CMMC and NIST SP 800-171 program build, Google Workspace to MS 365 migration, SIEM and DFIR, endpoint baseline and an open-source hardening tool."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Work</h1>
      <p>
        Each case study covers the setting, the decisions and their trade-offs, and where the work stands
        today. Employers are described by industry. Detail that would map a client's environment stays out.
      </p>
    </header>
    <Ledger items={work} />
  </div>
</Base>
