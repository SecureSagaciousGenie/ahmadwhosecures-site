---
// Author: Ahmad Shaukat
import Base from '../../layouts/Base.astro';
import CaseLedger from '../../components/CaseLedger.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Case files"
  description="Case studies in defense-sector security: CMMC and NIST SP 800-171 program build, Google Workspace to MS 365 migration, SIEM and DFIR, endpoint baseline and an open-source hardening tool."
>
  <div class="container">
    <header class="phead">
      <div class="art" data-art="page" aria-hidden="true"></div>
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li aria-current="page">Case files</li>
      </ol>
      <h1>Case files</h1>
      <p class="lede">
        Each case covers the problem, the decisions and their trade-offs, and the parts that carry over. Employers are
        described by industry, and names, counts, dates and configuration that would map an environment stay out.
      </p>
    </header>
    <div class="doc-after">
      <CaseLedger items={work} />
    </div>
  </div>
</Base>
