---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
---

<Base title="Route not found">
  <div class="container denied">
    <p class="code" aria-hidden="true">404</p>
    <p class="kicker">route lookup failed</p>
    <h1 style="font-size: var(--step-3)">Access denied: this route does not exist.</h1>
    <p style="color: var(--ink-2); max-width: 56ch">
      The address does not match a page on this site. Head back to a known route.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Return to base</a>
      <a class="btn btn-ghost" href="/work/">Case files</a>
      <a class="btn btn-ghost" href="/writing/">Field notes</a>
    </div>
  </div>
</Base>
