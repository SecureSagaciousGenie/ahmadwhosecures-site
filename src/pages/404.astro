---
// Author: Ahmad Shaukat
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="The address does not match a page on this site.">
  <div class="container denied">
    <div class="art" data-art="page" aria-hidden="true"></div>
    <p class="denied-code" aria-hidden="true">404</p>
    <h1 class="subhead" style="margin: 0">No page at this address</h1>
    <div class="denied-card">
      <b>Blocked</b>
      <p>The route does not match any page on this site. Head back to a known route, or press / to search.</p>
    </div>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Home<Icon name="arrow" /></a>
      <a class="btn btn-ghost" href="/work/">Case files</a>
      <a class="btn btn-ghost" href="/writing/">Field notes</a>
    </div>
  </div>
</Base>
