---
// Author: Ahmad Shaukat
// Page shell: metadata, header, footer and quick navigation.
// Navigation is plain page loads; browsers that support cross-document view transitions animate them.
import '@fontsource-variable/hubot-sans/standard.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/jetbrains-mono';
import displayFont from '@fontsource-variable/hubot-sans/files/hubot-sans-latin-standard-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
}

const { title, description = site.description, type = 'website', published } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const built = new Date();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: field notes`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0f17" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ahmad Shaukat, Principal Information Security Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline src="/js/boot.js"></script>
  </head>
  <body>
    <div class="art art-ambient" data-art="ambient" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer built={built} />
    <Palette />

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
